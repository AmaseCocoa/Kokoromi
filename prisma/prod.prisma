generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "cockroachdb" // mysql
  url      = "postgresql://kokoromi:cKgnltJhjEz-l95n6k_XLQ@amasec-blog-1444.jxf.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full" // env("DATABASE_URL")
}

model cmsMeta {
  id        Int   @id @default(1)
  title     String
  description String

  disallowAiLearning Boolean @default(false)
  hideKokoromiVersion Boolean @default(false)
  noindex Boolean @default(false)

  enableActivityPub Boolean @default(false)
  adsense String?

  giscusEnabled Boolean @default(false)
  giscusRepo String? @default("your-github-username/your-repo-name")
  giscusRepoId String?
  giscusCategoryName String?
  giscusCategoryId String?
  giscusThemeType String @default("preferred_color_scheme")
  ga4TrackingId String?
  cfAnalyticsToken String?
  showViewCounts Boolean @default(false)

  turnstileSiteKey String @default("1x00000000000000000000AA")
  turnstileSecretKey String @default("1x0000000000000000000000000000000AA")
}

model Post {
  id          String    @id
  title       String
  content     String
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  authorId    String
  viewCount   Int @default(0)
  author      author @relation(fields: [authorId], references: [id])
  draft       Boolean @default(false)
  noIndex     Boolean @default(false)
}

model socialLink {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url   String
  icon String
  authorId String
  author author @relation(fields: [authorId], references: [id])
}

model author {
  id  String @id
  name String
  mail String

  displayName String
  description String
  icon String @default("")
  socialLink socialLink[]
  tokens     Token[]
  password String
  posts Post[]
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Token {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  authorId  String
  user      author   @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
}